[
  {
    "context": "Workspace",
    "bindings": {
      "super-b": "workspace::ToggleLeftDock",
      "super-enter": [
        "picker::ConfirmInput",
        {
          "secondary": false
        }
      ],
      "super-f": "buffer_search::Deploy",
      "super-j": "workspace::ToggleBottomDock",
      "super-k super-s": "zed::OpenKeymap",
      "super-k m": "language_selector::Toggle",
      "super-k s": "workspace::SaveWithoutFormat",
      "super-n": "workspace::NewFile",
      "super-p": "file_finder::Toggle",
      "super-q": "workspace::CloseWindow",
      "super-r": "task::Rerun",
      "super-s": "workspace::Save",
      "super-shift-b": "outline_panel::ToggleFocus",
      "super-shift-e": "project_panel::ToggleFocus",
      "super-shift-f": "pane::DeploySearch",
      "super-shift-n": "workspace::NewWindow",
      "super-shift-p": "command_palette::Toggle",
      "super-shift-r": "task::Spawn",
      "super-t": "project_symbols::Toggle",
      "super-w": "pane::CloseActiveItem",
      "ctrl-shift-r": "projects::OpenRecent",
    },
  },
  {
    "context": "Pane",
    "bindings": {
      "ctrl-/": "pane::GoBack",
      "ctrl-?": "pane::GoForward",
      "super-shift-f": "project_search::ToggleFocus",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "shift-f12": "editor::FindAllReferences",
      "super-w": "pane::CloseActiveItem",
      "super-/": "editor::ToggleComments",
      "super-enter": "editor::NewlineBelow",
      "win-left": "editor::MoveToPreviousSubwordStart",
      "win-right": "editor::MoveToNextSubwordEnd",
      "win-shift-left": "editor::SelectToPreviousSubwordStart",
      "win-shift-right": "editor::SelectToNextSubwordEnd",
      "win-shift-up": "editor::MoveLineUp",
      "win-shift-down": "editor::MoveLineDown",
      "alt-up": "editor::MoveToBeginning",
      "alt-down": "editor::MoveToEnd",
      "alt-shift-up": "editor::SelectToBeginning",
      "alt-shift-down": "editor::SelectToEnd",
      "win-up": "editor::SelectLargerSyntaxNode",
      "win-down": "editor::SelectSmallerSyntaxNode",
      "alt-left": "editor::MoveToBeginningOfLine",
      "alt-right": "editor::MoveToEndOfLine",
      "alt-shift-left": "editor::SelectToBeginningOfLine",
      "alt-shift-right": "editor::SelectToEndOfLine",
      "super-a": "editor::SelectAll",
      "super-d": "editor::DuplicateLineUp",
      "super-z": "editor::Undo",
      "super-shift-z": "editor::Redo",
      "super-shift-k": "editor::DeleteLine",
      "ctrl--": "pane::GoBack",
      "ctrl-shift-/": "pane::GoForward",
      "super-t": "task::Spawn",
      "super-r": "task::Rerun",
      "super-.": "editor::ToggleCodeActions",
    },
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "ctrl-enter": "editor::OpenExcerpts",
      "super-o": "outline::Toggle",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "super-t": "workspace::NewTerminal",
      "super-w": "pane::CloseActiveItem",
      "ctrl-w": "editor::DeleteToPreviousWordStart",
    },
  },
  {
    "context": "BufferSearchBar",
    "bindings": {
      "super-g": "search::SelectNextMatch",
      "super-shift-g": "search::SelectPreviousMatch",
    },
  },
  {
    "context": "AgentPanel",
    "bindings": {
      "super-shift-e": "project_panel::ToggleFocus",
    },
  },
  {
    "context": "GitPanel",
    "bindings": {
      "super-enter": "git::Commit",
      "super-g super-g": "git::Fetch",
      "super-g down": "git::Pull",
      "super-g up": "git::Push",
      "super-shift-enter": "git::Amend",
    },
  },
  {
    "context": "GitCommit > Editor",
    "bindings": {
      "super-enter": "git::Commit",
      "super-shift-enter": "git::Amend",
    },
  },
  {
    "context": "CommitEditor > Editor",
    "bindings": {
      "super-enter": "git::Commit",
      "super-shift-enter": "git::Amend",
    },
  },
  {
    "context": "GitDiff > Editor",
    "bindings": {
      "super-enter": "git::Commit",
      "super-shift-enter": "git::Amend",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-super-b": "workspace::ToggleRightDock",
    },
  },
  {
    "context": "AcpThread > (Editor && use_modifier_to_send)",
    "bindings": {
      "super-enter": "agent::Chat"
    }
  },
  {
    "context": "AcpThread > Editor",
    "bindings": {
      "super-enter": "agent::ChatWithFollow"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "super-enter": "assistant::InlineAssist"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "super-1": [
        "pane::ActivateItem",
        0
      ]
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "alt-1": [
        "pane::ActivateItem",
        0
      ]
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "super-1": [
        "workspace::ActivatePane",
        0
      ]
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "alt-1": [
        "workspace::ActivatePane",
        0
      ]
    }
  },
  {
    "context": "RunModal",
    "bindings": {
      "super-1": "new_process_modal::ActivateTaskTab"
    }
  },
  {
    "context": "RunModal",
    "unbind": {
      "alt-1": "new_process_modal::ActivateTaskTab"
    }
  },
  {
    "context": "GitPicker",
    "bindings": {
      "super-1": "git_picker::ActivateBranchesTab"
    }
  },
  {
    "context": "GitPicker",
    "unbind": {
      "alt-1": "git_picker::ActivateBranchesTab"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "super-2": [
        "pane::ActivateItem",
        1
      ]
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "alt-2": [
        "pane::ActivateItem",
        1
      ]
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "super-3": [
        "pane::ActivateItem",
        2
      ]
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "alt-3": [
        "pane::ActivateItem",
        2
      ]
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "super-4": [
        "pane::ActivateItem",
        3
      ]
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "alt-4": [
        "pane::ActivateItem",
        3
      ]
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "super-5": [
        "pane::ActivateItem",
        4
      ]
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "alt-5": [
        "pane::ActivateItem",
        4
      ]
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "super-0": "pane::ActivateLastItem"
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "alt-0": "pane::ActivateLastItem"
    }
  }
]
